<?xml version="1.0" encoding="utf-8"?>
<!-- Torn-ticket edge: a perforation line for the top/bottom of a slip.
     Use as the background of a 2dp-tall View spanning the slip width. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="line">
    <stroke
        android:width="2dp"
        android:color="@color/print_faint"
        android:dashWidth="3dp"
        android:dashGap="4dp" />
</shape>

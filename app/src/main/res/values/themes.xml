<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Revline" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/redline</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/redline</item>
        <item name="colorSurface">@color/slip</item>
        <item name="colorOnSurface">@color/print</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="colorOnBackground">@color/print</item>
        <item name="colorError">@color/redline</item>

        <item name="android:windowBackground">@color/ink</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:textColorPrimary">@color/print</item>
        <item name="android:textColorSecondary">@color/print_dim</item>
        <item name="android:textColorHint">@color/print_faint</item>

        <!-- Inter is the default body face app-wide. -->
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>

        <!-- Match Material text appearances to the Time Slip faces. -->
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Revline.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Revline.Body</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Revline.Title</item>
    </style>

    <style name="TextAppearance.Revline.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.Revline.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

</resources>

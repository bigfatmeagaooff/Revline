<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <!-- Stub: recording -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_stage" />

        <TextView
            style="@style/Text.Stub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tracking_label"
            android:textColor="@color/stage" />

        <TextView
            style="@style/Text.Stub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tracking_gps_ok" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="14dp"
        android:layerType="software"
        android:background="@drawable/perf_line" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="0.55" />

    <TextView
        style="@style/Text.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/label_elapsed"
        android:textColor="@color/print_faint"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/elapsedTime"
        style="@style/Text.Readout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/print"
        android:textSize="36sp"
        tools:text="00:23:41" />

    <TextView
        android:id="@+id/liveSpeed"
        style="@style/Text.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="@color/redline"
        android:textSize="128sp"
        tools:text="109" />

    <TextView
        style="@style/Text.Unit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/unit_kmh"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/gforceLive"
        style="@style/Text.Readout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:textColor="@color/print_dim"
        android:textSize="14sp"
        tools:text="LAT 0.30 G   ·   ACC/BRK -0.50 G" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stopDriveButton"
        style="@style/Widget.Revline.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="@string/stop_drive" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Restored-from-server note -->
        <TextView
            android:id="@+id/restoredNote"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/restored_note"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- ================= THE SLIP ================= -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:orientation="vertical"
            android:background="@color/slip">

            <!-- Stub line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingTop="16dp">

                <TextView
                    style="@style/Text.Stub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/slip_masthead" />

                <TextView
                    android:id="@+id/heroDate"
                    style="@style/Text.Stub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="THU 27 AUG · 3:19 PM" />
            </LinearLayout>

            <!-- Hero: trap speed -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="18dp"
                android:text="@string/label_trap_speed"
                android:textColor="@color/print_faint"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="18dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/heroTopSpeed"
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/redline"
                    android:textSize="92sp"
                    tools:text="124" />

                <TextView
                    style="@style/Text.Unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/unit_kmh"
                    android:textSize="22sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/rule" />

            <!-- Ruled readout rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="@drawable/divider_rule"
                android:showDividers="middle"
                android:dividerPadding="0dp">

                <include android:id="@+id/cellDistance" layout="@layout/cell_stat"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include android:id="@+id/cellAvgSpeed" layout="@layout/cell_stat"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include android:id="@+id/cellDuration" layout="@layout/cell_stat"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include android:id="@+id/cellMovingTime" layout="@layout/cell_stat"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include android:id="@+id/cellZeroHundred" layout="@layout/cell_stat"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include android:id="@+id/cellPeakG" layout="@layout/cell_stat"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Filed-status foot -->
            <TextView
                android:id="@+id/uploadStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/rl_mono"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:padding="11dp"
                android:textAllCaps="true"
                android:textColor="@color/ink"
                android:textSize="11sp"
                android:visibility="gone"
                tools:background="@color/stage"
                tools:text="Filed to leaderboard"
                tools:visibility="visible" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="6dp" />
        </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="13dp"
                android:layout_gravity="top"
                android:background="@drawable/perf_top" />

            <View
                android:layout_width="match_parent"
                android:layout_height="13dp"
                android:layout_gravity="bottom"
                android:background="@drawable/perf_bottom" />
        </FrameLayout>

        <!-- Predicted vs actual -->
        <TextView
            android:id="@+id/predictionDelta"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textColor="@color/print"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Maps said 22 min — took 26 min (+4 min)"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/predictionEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prediction_prompt" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/predictionLayout"
                    style="@style/Widget.Revline.TextInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="@string/prediction_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/predictionInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/print" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addPredictionButton"
                    style="@style/Widget.Revline.Button.Outline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prediction_add" />
            </LinearLayout>
        </LinearLayout>

        <!-- ROUTE -->
        <TextView
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="28dp"
            android:text="@string/label_route_section" />

        <FrameLayout
            android:id="@+id/routeSection"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:background="@color/slip"
            android:foreground="@drawable/hairline_frame">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/mapPlaceholder"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/no_route_data"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- G-FORCE -->
        <LinearLayout
            android:id="@+id/gforceSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp">

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/label_gforce_section" />

            <com.revline.tracker.ui.GForceGraphView
                android:id="@+id/gforceGraph"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="12dp"
                android:background="@color/slip" />

            <TextView
                android:id="@+id/hardestBrakingValue"
                style="@style/Text.Readout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/print_dim"
                android:textSize="13sp"
                tools:text="HARDEST BRAKING  0.81 G" />
        </LinearLayout>

        <!-- DRIVE DETAIL -->
        <LinearLayout
            android:id="@+id/detailSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="4dp"
                android:text="@string/label_detail_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:background="@color/slip"
                android:orientation="vertical"
                android:divider="@drawable/divider_rule"
                android:showDividers="middle">

                <LinearLayout android:id="@+id/rowStops" style="@style/DetailRow"
                    android:paddingHorizontal="18dp" android:visibility="gone">
                    <TextView style="@style/DetailLabel" android:layout_width="0dp"
                        android:layout_weight="1" android:text="@string/label_stops" />
                    <TextView android:id="@+id/valueStops" style="@style/DetailValue" tools:text="7" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowCorneringPeak" style="@style/DetailRow"
                    android:paddingHorizontal="18dp" android:visibility="gone">
                    <TextView style="@style/DetailLabel" android:layout_width="0dp"
                        android:layout_weight="1" android:text="@string/label_cornering_peak" />
                    <TextView android:id="@+id/valueCorneringPeak" style="@style/DetailValue" tools:text="0.62 G" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowCorneringAvg" style="@style/DetailRow"
                    android:paddingHorizontal="18dp" android:visibility="gone">
                    <TextView style="@style/DetailLabel" android:layout_width="0dp"
                        android:layout_weight="1" android:text="@string/label_cornering_avg" />
                    <TextView android:id="@+id/valueCorneringAvg" style="@style/DetailValue" tools:text="0.28 G" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowElevation" style="@style/DetailRow"
                    android:paddingHorizontal="18dp" android:visibility="gone">
                    <TextView style="@style/DetailLabel" android:layout_width="0dp"
                        android:layout_weight="1" android:text="@string/label_elevation_gain" />
                    <TextView android:id="@+id/valueElevation" style="@style/DetailValue" tools:text="↑ 142 m · ↓ 138 m" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Comments -->
        <LinearLayout
            android:id="@+id/commentsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewCommentsButton"
                style="@style/Widget.Revline.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_comment"
                android:text="@string/view_comments" />
        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareButton"
                style="@style/Widget.Revline.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/share" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reuploadButton"
                style="@style/Widget.Revline.Button.OutlineRed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/reupload_button"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>

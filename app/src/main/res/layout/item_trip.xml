<?xml version="1.0" encoding="utf-8"?>
<!-- A drive, as a timing slip. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Revline.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Margin spine — redline once the run is filed to the leaderboard. -->
        <View
            android:id="@+id/statusSpine"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/print_faint"
            tools:background="@color/redline" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <!-- Stub -->
            <TextView
                android:id="@+id/tripDate"
                style="@style/Text.Stub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="RUN · THU 27 AUG · 15:19" />

            <!-- Hero: trap speed -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tripTopSpeed"
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/redline"
                    android:textSize="48sp"
                    tools:text="124" />

                <TextView
                    style="@style/Text.Unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/unit_kmh"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="9dp"
                    android:text="@string/label_top_speed"
                    android:textColor="@color/print_faint"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Secondary readout -->
            <TextView
                android:id="@+id/tripReadout"
                style="@style/Text.Readout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/print_dim"
                android:textSize="13sp"
                tools:text="16.3 km   ·   23:04   ·   avg 51" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
